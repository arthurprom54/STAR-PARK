# Credencial emitida no portal oficial da Supercell.
# A chave existe apenas no servidor; nunca coloque no HTML ou no JavaScript público.
BRAWL_STARS_API_TOKEN=

# Primeiro OWNER. Senha forte com pelo menos 14 caracteres.
# A conta é criada na primeira inicialização quando as três variáveis estão definidas.
STAR_PARK_OWNER_EMAIL=
STAR_PARK_OWNER_PASSWORD=

# Segredo aleatório longo para assinatura das sessões (mínimo recomendado: 32 bytes).
# Exemplo de geração: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
STAR_PARK_SESSION_SECRET=

# Fonte pública de catálogo (sem chave privada). Mantém retratos, classes, raridades e dados dos Brawlers atualizados.
BRAWL_CATALOG_API_URL=https://api.brawlapi.com/v1/brawlers

# Intervalo de sincronização do catálogo visual (horas; padrão 6).
BRAWLER_SYNC_INTERVAL_HOURS=6

# Intervalo de consulta dos perfis ativos e Battle Logs (segundos; padrão 60; mínimo 30).
STAR_PARK_PLAYER_SYNC_INTERVAL_SECONDS=60

# Intervalo mínimo global entre chamadas autenticadas à API oficial (ms; padrão 300).
STAR_PARK_API_MIN_REQUEST_INTERVAL_MS=300

# Use 1 somente em testes offline para desativar a consulta automática ao catálogo.
STAR_PARK_DISABLE_CATALOG_SYNC=0

# Porta HTTP local.
PORT=4173

# Armazenamento: use firestore no Render; json apenas para testes locais.
STAR_PARK_STORAGE_DRIVER=json

# Credenciais do Firebase Admin SDK (somente servidor; nunca inclua no frontend/GitHub).
# Opção recomendada: cole o JSON completo da conta de serviço em uma única variável privada.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa às credenciais JSON (use as três juntas):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Em produção, configure NODE_ENV=production atrás de HTTPS/reverse proxy.
NODE_ENV=development

# Recrutamento fechado por padrão. Altere para true somente depois de revisar privacidade e armazenamento.
STAR_PARK_RECRUITMENT_OPEN_ON_BOOT=false
