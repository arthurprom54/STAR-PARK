{
  "name": "star-park-house",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma comunitária independente para a House STAR PARK.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "migrate:firestore": "node scripts/migrate-json-to-firestore.mjs",
